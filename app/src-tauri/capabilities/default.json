{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands, the status event and dragging the title bar. Nothing else from core.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-status",
    "allow-add-site",
    "allow-remove-site",
    "allow-start-block",
    "allow-drink-potion",
    "allow-favicon",
    "allow-install-helper",
    "allow-add-app",
    "allow-remove-app",
    "allow-installed-apps",
    "allow-running-apps",
    "allow-app-icon",
    "allow-app-from-path",
    "allow-pick-app-in-finder"
  ]
}
